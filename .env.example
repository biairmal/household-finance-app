# Copy to .env.local. EXPO_PUBLIC_* values are baked into the app bundle: never put secrets here.
# Google Cloud OAuth client of type "Web application". Authorized redirect URIs:
#   https://<pages-url>/spikes/auth          (web / iPhone)
#   https://<pages-url>/oauth-callback       (Android, forwards to householdmoney://oauth)
#   http://localhost:8081/spikes/auth        (local dev)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Task 4 (Google Picker): a browser API key restricted to the Picker API, and the Cloud project number.
EXPO_PUBLIC_GOOGLE_API_KEY=
EXPO_PUBLIC_GOOGLE_APP_ID=
# Deployed Worker, e.g. https://household-money-edge.<you>.workers.dev
EXPO_PUBLIC_EDGE_URL=
# Deployed Pages site, e.g. https://household-money.pages.dev
EXPO_PUBLIC_WEB_URL=
